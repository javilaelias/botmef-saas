# botmef-saas — copiá a apps/api/.env (lo hace CERO.ps1 / botmef-saas.bat).
# Puertos: API 3011 · Web 3012 · Postgres 5438 · Redis 6380.

# Rol de aplicación (app_botmef: sin BYPASSRLS, no dueño). Lo usa la API en runtime.
DATABASE_URL="postgresql://app_botmef:app_botmef@localhost:5438/botmef?schema=public"
# Rol propietario: solo migraciones y seed (prisma.config.ts).
MIGRATION_DATABASE_URL="postgresql://botmef_owner:botmef_owner@localhost:5438/botmef?schema=public"
REDIS_URL="redis://localhost:6380"

PORT=3011
NODE_ENV="development"
CORS_ORIGINS="http://localhost:3012,http://127.0.0.1:3012"

JWT_SECRET="change-me-in-prod-please-32chars"
# AES-256-GCM: 32 bytes en base64 (openssl rand -base64 32). Versión de la clave vigente.
TOKEN_ENCRYPTION_KEY="change-me-base64-32-bytes"
TOKEN_KEY_VERSION=1
# Alta de tenant cerrada (C6): header de provisión para el endpoint administrativo.
ADMIN_PROVISION_KEY="change-me-admin-provision-key"

THROTTLE_ENABLED="true"
THROTTLE_TTL_SEC="60"
THROTTLE_LIMIT="300"
REQUEST_LOG_ENABLED="true"
