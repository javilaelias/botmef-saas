// Andamiaje (MB1): solo lo mínimo para que auth compile. El schema real (design.md §3) llega en MB2.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id       String    @id @default(uuid()) @db.Uuid
  nombre   String    @db.VarChar(140)
  usuarios Usuario[]

  @@map("tenants")
}

model Usuario {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  email        String    @db.VarChar(190)
  nombre       String    @db.VarChar(140)
  rol          String    @db.VarChar(20)
  activo       Boolean   @default(true)
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  ultimoLogin  DateTime? @map("ultimo_login") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId, rol])
  @@map("usuarios")
}
